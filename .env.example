# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=intelligent_farm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173
# First administrator (created at startup only if both are set and the email is unused)
ADMIN_EMAIL=
ADMIN_PASSWORD=
GEMINI_API_KEY=
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
NOTIFICATIONS_CRON=0 0 6 * * *
