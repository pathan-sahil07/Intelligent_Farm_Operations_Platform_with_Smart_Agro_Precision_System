# ── Neon PostgreSQL Database Configuration ──────────────────────
# JDBC connection URL (must start with jdbc:postgresql://)
DATABASE_URL="jdbc:postgresql://<neon-host>/<database>?sslmode=require&channel_binding=require"
DATABASE_USERNAME="neondb_owner"
DATABASE_PASSWORD="your_neon_password_here"

# ── Auth Cookie (for local development over plain HTTP) ─────────
# When running on http://localhost, __Host- prefix and Secure cookies are rejected by browsers.
# Use FARM_SESSION and false for local dev.
FARM_AUTH_COOKIE_NAME="FARM_SESSION"
FARM_AUTH_COOKIE_SECURE="false"

# ── HMAC Key (Session Token Signature & Verification) ───────────
# Requires a Base64-encoded key of at least 256 bits (32 bytes).
# Generate using: openssl rand -base64 32
FARM_AUTH_HMAC_CURRENT_KEY_VERSION="v1"
FARM_AUTH_HMAC_KEYS_V1="your_base64_hmac_key_here"

# ── Spring Boot Datasource Aliases ──────────────────────────────
SPRING_DATASOURCE_URL="jdbc:postgresql://<neon-host>/<database>?sslmode=require&channel_binding=require"
SPRING_DATASOURCE_USERNAME="neondb_owner"
SPRING_DATASOURCE_PASSWORD="your_neon_password_here"
