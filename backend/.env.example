PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/intelligent_farm
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
# Required: random string, 32+ characters. Example: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120
# Comma separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
# First administrator, created at startup only if both are set and the email is unused
ADMIN_EMAIL=
ADMIN_PASSWORD=
DOCUMENTS_DIRECTORY=/absolute/path/to/farm-documents
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
AI_SERVICE_URL=http://localhost:8000
NOTIFICATIONS_CRON=0 0 6 * * *

# Local run without PostgreSQL (in-memory H2, development only):
# mvn spring-boot:run -Dspring-boot.run.profiles=demo
